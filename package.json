{
  "name": "@lone-wolf-akela/dsh-fakeip-web-fetch",
  "version": "0.1.0",
  "description": "DSH bundle that keeps web_fetch working behind a fake-IP DNS (Clash/mihomo, sing-box, Surge): it replaces the anonymous HTTP fetch provider with the same provider widened to accept the local fake-IP pool, while loopback, RFC 1918, link-local and carrier-grade NAT destinations stay blocked.",
  "type": "module",
  "license": "MIT",
  "author": "lone-wolf-akela",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lone-wolf-akela/dsh-fakeip-web-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/lone-wolf-akela/dsh-fakeip-web-fetch/issues"
  },
  "homepage": "https://github.com/lone-wolf-akela/dsh-fakeip-web-fetch#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "web-fetch",
    "fake-ip",
    "clash",
    "mihomo",
    "openclash",
    "sing-box",
    "ssrf"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.2.2-0"
    }
  },
  "scripts": {
    "test": "node test/unit.mjs"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-web": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-web-fetch-http": ">=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
